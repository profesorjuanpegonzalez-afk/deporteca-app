# Copia este archivo a .env (en esta misma carpeta) y rellena los valores.
# .env está en .gitignore: nunca lo subas al repositorio.
# Nota: todas las variables REACT_APP_* acaban dentro del JavaScript público;
# protege las claves con restricciones en Google Cloud / Firebase.

REACT_APP_BACKEND_API_BASE=http://127.0.0.1:8000

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=deporteca.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=deporteca
REACT_APP_FIREBASE_STORAGE_BUCKET=deporteca.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=809192847817
REACT_APP_FIREBASE_APP_ID=1:809192847817:web:0562c8ac36cd7821edd018

# Google Places (autocompletado de direcciones)
REACT_APP_GOOGLE_MAPS_API_KEY=
